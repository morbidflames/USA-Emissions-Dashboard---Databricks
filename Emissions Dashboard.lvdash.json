{
  "datasets": [
    {
      "name": "e45aa872",
      "displayName": "Location Data",
      "queryLines": [
        "SELECT latitude,longitude, `GHG emissions mtons CO2e` as Emissions\r\n",
        " FROM emissions.default.emissions_data"
      ]
    },
    {
      "name": "da8f9b25",
      "displayName": "Emissions_per_person",
      "queryLines": [
        "SELECT county_state_name,\r\n",
        "       population,\r\n",
        "       CAST(\r\n",
        "            replace(`GHG emissions mtons CO2e`, ',', '')\r\n",
        "       AS DOUBLE) / NULLIF(CAST(replace(population, ',', '')\r\n",
        "       AS DOUBLE), 0) AS Emissions_per_person\r\n",
        " FROM emissions.default.emissions_data  \r\n",
        " ORDER BY emissions_per_person DESC\r\n"
      ],
      "catalog": "emissions",
      "schema": "default"
    },
    {
      "name": "30fbe761",
      "displayName": "Total emissions per State",
      "queryLines": [
        "SELECT state_abbr,\r\n",
        "       SUM(CAST(\r\n",
        "            replace(`GHG emissions mtons CO2e`, ',', '')\r\n",
        "            AS DOUBLE)) AS Total_Emissions\r\n",
        " FROM emissions_data\r\n",
        " GROUP BY state_abbr\r\n",
        " ORDER BY Total_Emissions DESC\r\n",
        " LIMIT 10"
      ],
      "catalog": "emissions",
      "schema": "default"
    },
    {
      "name": "38b315e2",
      "displayName": "County Shaming",
      "queryLines": [
        "SELECT county_state_name,\r\n",
        "       population,\r\n",
        "       CAST(\r\n",
        "            replace(`GHG emissions mtons CO2e`, ',', '')\r\n",
        "       AS DOUBLE) AS Total_Emissions\r\n",
        " FROM emissions_data\r\n",
        " ORDER BY total_emissions DESC\r\n",
        " LIMIT 10"
      ],
      "catalog": "emissions",
      "schema": "default"
    }
  ],
